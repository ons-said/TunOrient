````python
def calculate_fit_score(student, program, admission_rule):
    # Example: score_formula = "0.4*Math + 0.3*Physics + 0.3*French"
    # student_grades = {"Math": 15, "Physics": 14, "French": 13}
    formula = admission_rule.score_formula
    if not formula:
        return None
    # Simple parser (for demo; use a safe eval in production)
    score = formula
    for subject, grade in student.grades.items():
        score = score.replace(subject, str(grade))
    try:
        fit_score = eval(score)
    except Exception:
        fit_score = None
    return fit_score

def recommend_programs(student_profile):
    # Fetch all programs and their admission rules
    recommendations = []
    for program in get_all_programs():
        rule = get_admission_rule_for_program(program, student_profile.bac_section)
        fit_score = calculate_fit_score(student_profile, program, rule)
        likelihood = None
        if fit_score and rule.last_admitted_score:
            likelihood = "High" if fit_score >= rule.last_admitted_score else "Low"
        recommendations.append({
            "program": program,
            "fit_score": fit_score,
            "likelihood": likelihood,
        })
    # Filter by interests, location, etc.
    if student_profile.interests:
        recommendations = [r for r in recommendations if any(i in r["program"].fields for i in student_profile.interests)]
    if student_profile.governorate:
        recommendations = [r for r in recommendations if r["program"].region == student_profile.governorate]
    return recommendations
````


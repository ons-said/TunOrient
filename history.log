  useEffect(() => {
    getStudent(id)
      .then(res => setStudent(res.data))
      .catch(err => setError("Could not load student profile"));
  }, [id]);

  if (error) return <div>{error}</div>;
  if (!student) return <div>Loading...</div>;

  return (
    <div>
      <h2>Student Profile</h2>
      <p><b>Academic Level:</b> {student.academic_level}</p>
      <p><b>Governorate:</b> {student.governorate}</p>
      <p><b>Bac Year:</b> {student.bac_year}</p>
      {student.bac_section && <p><b>Bac Section:</b> {student.bac_section}</p>}
      {student.bac_average && <p><b>Bac Average:</b> {student.bac_average}</p>}
      {student.interests && (
        <div>
          <b>Interests:</b>
          <ul>
            {student.interests.map((i, idx) => <li key={idx}>{i}</li>)}
          </ul>
        </div>
      )}
    </div>
  );
}
```


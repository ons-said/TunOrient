import React, { useState, useContext } from "react";
import { login as apiLogin } from "../../api/auth";
import { AuthContext } from "../../context/AuthContext";
import { useNavigate } from "react-router-dom";

export default function LoginForm() {
  const [form, setForm] = useState({ email: "", password: "" });
  const [error, setError] = useState("");
  const { login } = useContext(AuthContext);
  const navigate = useNavigate();

  const handleChange = (e) => setForm({ ...form, [e.target.name]: e.target.value });

  const handleSubmit = async (e) => {
    e.preventDefault();
    setError("");
    try {
      const res = await apiLogin(form);
      // Assume backend returns user info in token payload or fetch user after login
      const token = res.data.access_token;
      // Optionally decode token to get user info, or fetch user profile here
      login({ email: form.email, role: "student" }, token); // Adjust role as needed
      navigate("/");
    } catch (err) {
      setError(err.response?.data?.detail || "Login failed");
    }
  };

  return (
    <form onSubmit={handleSubmit}>
      <h2>Login</h2>
      {error && <div style={{ color: "red" }}>{error}</div>}
      <label>
        Email:
        <input name="email" value={form.email} onChange={handleChange} required />
      </label>
      <label>
        Password:
        <input name="password" type="password" value={form.password} onChange={handleChange} required />
      </label>
      <button type="submit">Login</button>
    </form>
  );
}
```


## 7. Example: Student Registration Form (with interests questionnaire)

```javascript
// src/components/Students/StudentForm.js
import React, { useState } from "react";
import { createStudent } from "../../api/students";

const INTEREST_OPTIONS = [
  "Medicine & Health Sciences",
  "Engineering & Technology",
  "Computer Science & IT",
  "Business & Economics",
  "Law & Political Science",
  "Arts & Humanities",
  "Social Sciences",
  "Agronomy & Life Sciences",
  "Sports",
  "Education",
  "Other"
];

export default function StudentForm({ onSuccess }) {
  const [form, setForm] = useState({
    academic_level: "bac",
    bac_section: "",
    bac_average: "",
    bac_year: "",
    governorate: "",
    interests: [],
  });
  const [error, setError] = useState("");

  const handleChange = (e) => {
    setForm({ ...form, [e.target.name]: e.target.value });
  };

  const handleInterestChange = (interest) => {
    setForm((prev) => ({
      ...prev,
      interests: prev.interests.includes(interest)
        ? prev.interests.filter((i) => i !== interest)
        : [...prev.interests, interest],
    }));
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    try {
      await createStudent(form);
      onSuccess && onSuccess();
    } catch (err) {
      setError(err.response?.data?.detail || "Error creating profile");
    }
  };

  return (
    <form onSubmit={handleSubmit}>
      <h2>Create Student Profile</h2>
      {error && <div style={{ color: "red" }}>{error}</div>}
      <label>
        Academic Level:
        <select name="academic_level" value={form.academic_level} onChange={handleChange}>
          <option value="bac">Baccalaureate</option>
          <option value="secondary_1">1ère année secondaire</option>
          <option value="secondary_2">2ème année secondaire</option>
          <option value="secondary_3">3ème année secondaire</option>
          <option value="secondary_4">4ème année secondaire</option>
          <option value="reo">Reorientation Exam</option>
        </select>
      </label>
      <label>
        Governorate:
        <input name="governorate" value={form.governorate} onChange={handleChange} required />
      </label>
      <label>
        Expected Bac Year:
        <input name="bac_year" value={form.bac_year} onChange={handleChange} required />
      </label>
      {(form.academic_level === "bac" || form.academic_level === "reo" || form.academic_level === "secondary_3" || form.academic_level === "secondary_4") && (
        <label>
          Bac Section:
          <input name="bac_section" value={form.bac_section} onChange={handleChange} required />
        </label>
      )}
      {(form.academic_level === "bac" || form.academic_level === "reo") && (
        <label>
          Bac Average:
          <input name="bac_average" type="number" step="0.01" value={form.bac_average} onChange={handleChange} required />
        </label>
      )}
      <fieldset>
        <legend>Your Interests (select all that apply):</legend>
        {INTEREST_OPTIONS.map((interest) => (
          <label key={interest}>
            <input
              type="checkbox"
              checked={form.interests.includes(interest)}
              onChange={() => handleInterestChange(interest)}
            />
            {interest}
          </label>
        ))}
      </fieldset>
      <button type="submit">Save Profile</button>
    </form>
  );
}
```


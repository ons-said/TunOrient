@router.post("/{student_id}", response_model=List[OrientationResultRead])
def run_recommendation(student_id: int, db: Session = Depends(get_db), current_user=Depends(get_current_user)):
    """
    Generate orientation recommendations for a student.
    Authorization: user must be authenticated. (Further role-based guard can be added.)
    """
    svc = RecommendationService(db)
    try:
        results = svc.generate_for_student(student_id)
    except ValueError:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="Student not found")
    return results

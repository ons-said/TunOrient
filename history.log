### CircularDetail.js

```javascript
import React, { useEffect, useState } from "react";
import { getCircular } from "../../api/circulars";
import { useParams } from "react-router-dom";

export default function CircularDetail() {
  const { id } = useParams();
  const [circular, setCircular] = useState(null);

  useEffect(() => {
    getCircular(id).then(res => setCircular(res.data));
  }, [id]);

  if (!circular) return <div>Loading...</div>;
  return (
    <div>
      <h2>{circular.title}</h2>
      <p>Academic Year: {circular.academic_year}</p>
      <p>Publication Date: {circular.publication_date}</p>
      <p>Deadline Date: {circular.deadline_date}</p>
      <p>Description: {circular.description}</p>
    </div>
  );
}
```


### RecommendationButton.js

```javascript
import React, { useState } from "react";
import { runRecommendation } from "../../api/recommendations";
import { useParams } from "react-router-dom";

export default function RecommendationButton() {
  const { studentId } = useParams();
  const [message, setMessage] = useState("");

  const handleClick = async () => {
    try {
      await runRecommendation(studentId);
      setMessage("Recommendations generated! Check your results.");
    } catch {
      setMessage("Failed to generate recommendations.");
    }
  };

  return (
    <div>
      <button onClick={handleClick}>Run Recommendation</button>
      {message && <div>{message}</div>}
    </div>
  );
}
```

### RecommendationResults.js


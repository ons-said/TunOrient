// ...other imports...

export default function AppRoutes() {
  return (
    <Routes>
      <Route path="/login" element={<LoginForm />} />
      <Route path="/register" element={<RegisterForm />} />
      <Route
        path="/students/create"
        element={
          <ProtectedRoute roles={["student", "admin"]}>
            <StudentForm />
          </ProtectedRoute>
        }
      />
      <Route
        path="/students/:id"
        element={
          <ProtectedRoute roles={["student", "admin"]}>
            <StudentProfile />
          </ProtectedRoute>
        }
      />
      {/* Add routes for universities, institutions, programs, etc. */}
    </Routes>
  );
}

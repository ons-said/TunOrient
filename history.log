from sqlalchemy.orm import Session
from typing import List
from app.features.orientations.model import OrientationResult

class OrientationResultRepository:
    def __init__(self, db: Session):
        self.db = db

    def list_for_student(self, student_id: int) -> List[OrientationResult]:
        return self.db.query(OrientationResult).filter(OrientationResult.student_id == student_id).order_by(OrientationResult.created_at.desc()).all()

    def create(self, student_id: int, program_id: int, score: float, decision: str):
        obj = OrientationResult(student_id=student_id, program_id=program_id, score=score, decision=decision)
        self.db.add(obj)
        self.db.commit()
        self.db.refresh(obj)
        return obj
````


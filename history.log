````python
# ...existing code...
from sqlalchemy.orm import Session
from typing import List, Optional
from app.features.students.model import Student
from app.features.students.schemas import StudentCreate, StudentUpdate

class StudentService:
    def __init__(self, db: Session):
        self.db = db

    def create_student(self, payload: StudentCreate) -> Student:
        obj = Student(
            academic_level=payload.academic_level,
            specialization=payload.specialization,
            region=payload.region,
            bac_average=payload.bac_average,
        )
        self.db.add(obj)
        self.db.commit()
        self.db.refresh(obj)
        return obj

    def get_student(self, student_id: int) -> Optional[Student]:
        return self.db.query(Student).filter(Student.id == student_id).first()

    def list_students(self) -> List[Student]:
        return self.db.query(Student).order_by(Student.id).all()

    def update_student(self, student_id: int, payload: StudentUpdate) -> Student:
        obj = self.get_student(student_id)
        if not obj:
            raise ValueError("Student not found")
        if payload.academic_level is not None:
            obj.academic_level = payload.academic_level
        if payload.specialization is not None:
            obj.specialization = payload.specialization
        if payload.region is not None:
            obj.region = payload.region
        if payload.bac_average is not None:
            obj.bac_average = payload.bac_average
        self.db.add(obj)
        self.db.commit()
        self.db.refresh(obj)
        return obj

    def delete_student(self, student_id: int):
        obj = self.get_student(student_id)
        if not obj:
            raise ValueError("Student not found")
        self.db.delete(obj)
        self.db.commit()

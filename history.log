        Name: <input name="name" value={form.name} onChange={handleChange} required />
      </label>
      <label>
        Degree: <input name="degree" value={form.degree} onChange={handleChange} required />
      </label>
      <label>
        Field: <input name="field" value={form.field} onChange={handleChange} required />
      </label>
      <label>
        Capacity: <input name="capacity" type="number" value={form.capacity} onChange={handleChange} required />
      </label>
      <label>
        Institution:
        <select name="institution_id" value={form.institution_id} onChange={handleChange} required>
          <option value="">Select</option>
          {institutions.map(i => (
            <option key={i.id} value={i.id}>{i.name}</option>
          ))}
        </select>
      </label>
      <label>
        Reorientation Allowed:
        <input
          name="reorientation_allowed"
          type="checkbox"
          checked={form.reorientation_allowed}
          onChange={handleChange}
        />
      </label>
      <label>
        Reorientation Mode:
        <input name="reorientation_mode" value={form.reorientation_mode} onChange={handleChange} />
      </label>
      <button type="submit">Create</button>
    </form>
  );
}

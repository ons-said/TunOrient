ons-said: this is what I have in service.py from sqlalchemy.orm import Session
from typing import List
import ast
from app.features.students.model import Student
from app.features.programs.model import Program
from app.features.admission_rules.model import AdmissionRule
from app.features.orientations.repository import OrientationResultRepository

class RecommendationService:
    """
    RecommendationService:
    - Uses student grades and admission rules with score_formula
    - Persists OrientationResult rows (fit_score and likelihood)
    - Filters by interests and governorate
    - Ranks recommendations by fit_score descending
    """

    def __init__(self, db: Session):
        self.db = db
        self.or_repo = OrientationResultRepository(db)

    def calculate_fit_score(self, student: Student, rule: AdmissionRule) -> float | None:
        """
        Calculate a fit score using rule.score_formula.
        Safe evaluation using numexpr instead of eval.
        Example formula: "0.4*Math + 0.3*Physics + 0.3*French"
        """
        formula = getattr(rule, "score_formula", None)
        if not formula or not hasattr(student, "grades") or not student.grades:
            return None

        expr = formula
        for subject, grade in student.grades.items():
            # Replace subject names in formula with numeric values
            expr = expr.replace(subject, str(grade))

        try:
            fit_score = ast.literal_eval(expr)  
        except Exception:
            fit_score = None

        return fit_score

    def generate_for_student(self, student_id: int, limit: int = 20) -> List:
        student = self.db.query(Student).filter(Student.id == student_id).first()
        if not student:
            raise ValueError("Student not found")

        recommendations = []

        # Load admission rules joined to programs
        rules = (
            self.db.query(AdmissionRule)
            .join(Program, AdmissionRule.program_id == Program.id)
            .all()
        )

        for rule in rules:
            program = self.db.query(Program).filter(Program.id == rule.program_id).first()
            if not program:
                continue

            # Bac section compatibility
            if rule.bac_section and student.bac_section:
                if rule.bac_section.strip().lower() != student.bac_section.strip().lower():
                    continue

            # Calculate fit_score using formula
            fit_score = self.calculate_fit_score(student, rule)

            # Determine likelihood based on historical admission
            likelihood = None
            if fit_score is not None and getattr(rule, "last_admitted_score", None) is not None:
                likelihood = "High" if fit_score >= rule.last_admitted_score else "Low"

            # Persist orientation result for audit
            row = self.or_repo.create(
                student_id=student_id,
                program_id=program.id,
                fit_score=fit_score,
                likelihood=likelihood
            )

            recommendations.append((row, fit_score or 0))

        # Rank by fit_score descending
        recommendations.sort(key=lambda t: t[1], reverse=True)

        # Filter by interests
        if getattr(student, "interests", None):
            recommendations = [
                r for r, _ in recommendations
                if any(i in r.program.fields for i in student.interests)
            ]

        # Filter by governorate
        if getattr(student, "governorate", None):
            recommendations = [
                r for r, _ in recommendations
                if r.program.region == student.governorate
            ]

        # Return top N results
        results = [r for r, _ in recommendations][:limit]
        return results



from datetime import datetime
from sqlalchemy import Column, Integer, String, Float, DateTime, ForeignKey, Text, DECIMAL
from sqlalchemy.dialects.postgresql import ARRAY
from sqlalchemy.orm import relationship
from app.database import Base

class AdmissionRule(Base):
    __tablename__ = "admission_rules"
    id = Column(Integer, primary_key=True, index=True)
    program_id = Column(Integer, ForeignKey("programs.id", ondelete="CASCADE"), nullable=False, index=True)
    bac_section = Column(String, nullable=True)       # Tunisian bac section
    minimum_average = Column(Float, nullable=False)   # historical threshold
    score_formula = Column(Text, nullable=True)       # e.g. "0.4*Math + 0.3*Physics + 0.3*French"
    required_subjects = Column(ARRAY(String), nullable=True)  # e.g. ['Math', 'Physics']
    additional_conditions = Column(Text, nullable=True)       # e.g. "Test required"
    academic_year = Column(String, nullable=True)
    last_admitted_score = Column(DECIMAL(4,2), nullable=True) # For informational purposes
    notes = Column(Text, nullable=True)
    created_at = Column(DateTime, default=datetime.utcnow)

    program = relationship("Program", backref="admission_rules", lazy="joined")
````

**Notes:**
- Use `ARRAY(String)` for `required_subjects` if you use PostgreSQL. For other databases, you may need a different approach.

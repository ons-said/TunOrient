```javascript
import React from "react";
import { BrowserRouter, Routes, Route } from "react-router-dom";

// Students
import StudentList from "./components/Students/StudentList";
import StudentProfile from "./components/Students/StudentProfile";
import StudentForm from "./components/Students/StudentForm";
import StudentEditForm from "./components/Students/StudentEditForm";

// Universities
import UniversityList from "./components/Universities/UniversityList";
import UniversityForm from "./components/Universities/UniversityForm";
import UniversityDetail from "./components/Universities/UniversityDetail";

// Institutions
import InstitutionList from "./components/Institutions/InstitutionList";
import InstitutionForm from "./components/Institutions/InstitutionForm";
import InstitutionDetail from "./components/Institutions/InstitutionDetail";

// Programs
import ProgramList from "./components/Programs/ProgramList";
import ProgramForm from "./components/Programs/ProgramForm";
import ProgramDetail from "./components/Programs/ProgramDetail";

// Admission Rules
import AdmissionRuleList from "./components/AdmissionRules/AdmissionRuleList";
import AdmissionRuleForm from "./components/AdmissionRules/AdmissionRuleForm";

// Circulars
import CircularList from "./components/Circulars/CircularList";
import CircularForm from "./components/Circulars/CircularForm";
import CircularDetail from "./components/Circulars/CircularDetail";

// Recommendations
import RecommendationButton from "./components/Recommendations/RecommendationButton";
import RecommendationResults from "./components/Recommendations/RecommendationResults";

// Auth
import LoginForm from "./components/Auth/LoginForm";
import RegisterForm from "./components/Auth/RegisterForm";

// Layout
// import Navbar from "./components/Layout/Navbar"; // Uncomment if you have a Navbar

function App() {
  return (
    <BrowserRouter>
      {/* <Navbar /> */}
      <Routes>
        {/* Auth */}
        <Route path="/login" element={<LoginForm />} />
        <Route path="/register" element={<RegisterForm />} />

        {/* Students */}
        <Route path="/students" element={<StudentList />} />
        <Route path="/students/create" element={<StudentForm />} />
        <Route path="/students/:id" element={<StudentProfile />} />
        <Route path="/students/:id/edit" element={<StudentEditForm />} />

        {/* Universities */}
        <Route path="/universities" element={<UniversityList />} />
        <Route path="/universities/create" element={<UniversityForm />} />
        <Route path="/universities/:id" element={<UniversityDetail />} />

        {/* Institutions */}
        <Route path="/institutions" element={<InstitutionList />} />
        <Route path="/institutions/create" element={<InstitutionForm />} />
        <Route path="/institutions/:id" element={<InstitutionDetail />} />

        {/* Programs */}
        <Route path="/programs" element={<ProgramList />} />
        <Route path="/programs/create" element={<ProgramForm />} />
        <Route path="/programs/:id" element={<ProgramDetail />} />

        {/* Admission Rules */}
        <Route path="/admission-rules" element={<AdmissionRuleList />} />
        <Route path="/admission-rules/create" element={<AdmissionRuleForm />} />

        {/* Circulars */}
        <Route path="/circulars" element={<CircularList />} />
        <Route path="/circulars/create" element={<CircularForm />} />
        <Route path="/circulars/:id" element={<CircularDetail />} />

        {/* Recommendations */}
        <Route path="/recommendations/:studentId" element={<RecommendationButton />} />
        <Route path="/orientations/:studentId" element={<RecommendationResults />} />

        {/* Default route */}
        <Route path="*" element={<StudentList />} />
      </Routes>
    </BrowserRouter>
  );
}

export default App;
```


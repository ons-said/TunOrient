**Correct usage in your register endpoint:**

````python
# ...existing code...
from fastapi import APIRouter, HTTPException, status, Depends
from sqlalchemy.orm import Session
from app.database import get_db
from app.features.auth import schemas
from app.features.auth.service import AuthService, hash_password  # import hash_password

router = APIRouter(prefix="/auth", tags=["auth"])

@router.post("/register", response_model=schemas.UserRead, status_code=status.HTTP_201_CREATED)
def register(payload: schemas.UserCreate, db: Session = Depends(get_db)):
    svc = AuthService(db)
    try:
        hashed = hash_password(payload.password)  # use the standalone function
        user = svc.create_user(payload.email, hashed, payload.role)
    except ValueError as e:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))
    return user
# ...existing code...
````

**Summary:**  
- Use `hash_password(payload.password)`, not `svc.hash_password(...)`.
- Make sure `hash_password` is imported from your auth service module.


9) recommendations service (use bac_section + minimum_average, rank results)
````python
from sqlalchemy.orm import Session
from typing import List
from app.features.students.model import Student
from app.features.programs.model import Program
from app.features.admission_rules.model import AdmissionRule
from app.features.orientations.repository import OrientationResultRepository

class RecommendationService:
    """
    RecommendationService (Tunisia):
    - uses student.bac_section + bac_average + historical admission rules (minimum_average)
    - generates ranked recommendations (higher score gap -> higher rank)
    - persists OrientationResult rows for transparency
    - does NOT submit choices
    """
    def __init__(self, db: Session):
        self.db = db
        self.or_repo = OrientationResultRepository(db)

    def generate_for_student(self, student_id: int, limit: int = 20) -> List:
        student = self.db.query(Student).filter(Student.id == student_id).first()
        if not student:
            raise ValueError("Student not found")

        if student.bac_average is None:
            return []

        # join rules to programs
        rules = self.db.query(AdmissionRule).join(Program, AdmissionRule.program_id == Program.id).all()

        scored = []
        for rule in rules:
            program = self.db.query(Program).filter(Program.id == rule.program_id).first()
            if not program:
                continue

            # bac_section compatibility (if rule defines a section)
            if rule.bac_section and student.bac_section:
                if rule.bac_section.strip().lower() != student.bac_section.strip().lower():
                    continue

            # compute numeric gap: student_avg - minimum_average
            gap = student.bac_average - rule.minimum_average
            decision = "eligible" if gap >= 0 else "not_eligible"
            score = gap

            # Persist orientation result (traceability)
            row = self.or_repo.create(student_id=student_id, program_id=program.id, score=score, decision=decision)
            scored.append((row, score))

        # rank by score descending (best fit first)
        scored.sort(key=lambda t: t[1], reverse=True)

        # return only the OrientationResult objects in ranked order (limit)
        results = [r for r, _ in scored][:limit]
        return results
````

Notes
- I changed admission rule field names and updated all call sites in repository/service/recommendations.
- Program.reorientation_allowed stored as optional bool in schemas; model uses string to avoid sqlite boolean issues — change to Boolean if you prefer and run migrations.
- Recommendation engine now ranks by score gap and persists OrientationResult rows; it does not perform any application submission.
- You should restart server to create/update tables: python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000
- If you want, I can also:

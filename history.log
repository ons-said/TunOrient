import React, { useEffect, useState } from "react";
import { getOrientationResults } from "../../api/recommendations";
import { useParams } from "react-router-dom";

export default function RecommendationResults() {
  const { studentId } = useParams();
  const [results, setResults] = useState([]);

  useEffect(() => {
    getOrientationResults(studentId).then(res => setResults(res.data));
  }, [studentId]);

  return (
    <div>
      <h2>Orientation Results</h2>
      <ul>
        {results.map(r => (
          <li key={r.id}>
            Program ID: {r.program_id}, Score Gap: {r.score_gap}, Decision: {r.decision}, Date: {r.created_at}
          </li>
        ))}
      </ul>
    </div>
  );
}
```


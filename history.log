```python
import json

class StudentService:
    # ...existing code...

    def create_student(self, payload: StudentCreate, user_id: int) -> Student:
        obj = Student(
            user_id=user_id,
            academic_level=payload.academic_level,
            bac_section=payload.bac_section,
            bac_average=payload.bac_average,
            bac_year=payload.bac_year,
            governorate=payload.governorate,
            interests=json.dumps(payload.interests) if payload.interests else None,  # NEW
        )
        self.db.add(obj)
        self.db.commit()
        self.db.refresh(obj)
        return obj

    def get_student(self, student_id: int) -> Optional[Student]:
        obj = self.db.query(Student).filter(Student.id == student_id).first()
        if obj and obj.interests:
            obj.interests = json.loads(obj.interests)
        return obj

    def update_student(self, student_id: int, payload: StudentUpdate) -> Student:
        obj = self.get_student(student_id)
        # ...existing updates...
        if payload.interests is not None:
            obj.interests = json.dumps(payload.interests)
        self.db.add(obj)
        self.db.commit()
        self.db.refresh(obj)
        if obj.interests:
            obj.interests = json.loads(obj.interests)
        return obj
```


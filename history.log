from app.features.orientations.model import Orientation
from app.features.orientations.schemas import OrientationCreate, OrientationUpdate

class OrientationRepository:
    def __init__(self, db: Session):
        self.db = db

    def create(self, payload: OrientationCreate) -> Orientation:
        obj = Orientation(name=payload.name, description=payload.description)
        self.db.add(obj)
        self.db.commit()
        self.db.refresh(obj)
        return obj

    def get(self, obj_id: int) -> Optional[Orientation]:
        return self.db.query(Orientation).filter(Orientation.id == obj_id).first()

    def list_all(self) -> List[Orientation]:
        return self.db.query(Orientation).order_by(Orientation.id).all()

    def update(self, obj: Orientation, payload: OrientationUpdate) -> Orientation:
        if payload.name is not None:
            obj.name = payload.name
        if payload.description is not None:
            obj.description = payload.description
        self.db.add(obj)
        self.db.commit()
        self.db.refresh(obj)
        return obj

    def delete(self, obj: Orientation):
        self.db.delete(obj)
        self.db.commit()

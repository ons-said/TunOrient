### AdmissionRuleForm.js

```javascript
import React, { useState, useEffect } from "react";
import { createAdmissionRule } from "../../api/admissionRules";
import { listPrograms } from "../../api/programs";
import { useNavigate } from "react-router-dom";

export default function AdmissionRuleForm() {
  const [form, setForm] = useState({
    program_id: "",
    bac_section: "",
    minimum_average: "",
    academic_year: "",
  });
  const [programs, setPrograms] = useState([]);
  const [error, setError] = useState("");
  const navigate = useNavigate();

  useEffect(() => {
    listPrograms().then(res => setPrograms(res.data));
  }, []);

  const handleChange = e => setForm({ ...form, [e.target.name]: e.target.value });

  const handleSubmit = async e => {
    e.preventDefault();
    try {
      await createAdmissionRule(form);
      navigate("/admission-rules");
    } catch (err) {
      setError("Creation failed");
    }
  };

  return (
    <form onSubmit={handleSubmit}>
      <h2>Create Admission Rule</h2>
      {error && <div style={{ color: "red" }}>{error}</div>}
      <label>
        Program:
        <select name="program_id" value={form.program_id} onChange={handleChange} required>
          <option value="">Select</option>
          {programs.map(p => (
            <option key={p.id} value={p.id}>{p.name}</option>
          ))}
        </select>
      </label>
      <label>
        Bac Section: <input name="bac_section" value={form.bac_section} onChange={handleChange} required />
      </label>
      <label>
        Minimum Average: <input name="minimum_average" type="number" step="0.01" value={form.minimum_average} onChange={handleChange} required />
      </label>
      <label>
        Academic Year: <input name="academic_year" value={form.academic_year} onChange={handleChange} required />
      </label>
      <button type="submit">Create</button>
    </form>
  );
}
```

